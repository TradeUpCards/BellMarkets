# BellMarkets automation service — env shape.
# Copy to .env locally and fill in real values. .env is gitignored.
# Never commit secrets (constitution/hard-rules.md §1.2).

# Trigger.dev project reference (the cron platform that runs the morning +
# settlement jobs). Get from Trigger.dev dashboard once the project is created.
TRIGGER_PROJECT_REF=

# Solana RPC endpoint for the automation service (devnet for the core
# submission; mainnet-beta is post-demo stretch only — never use real funds
# per constitution/hard-rules.md §1.1).
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Pyth HTTP API for previous-close reads at morning strike calculation.
# We use HTTP off-chain here (not the on-chain Pyth account) since the strike
# calc is off-chain. On-chain settlement reads (Aria's program) use the
# vendored Pyth account parser — see specs/architecture.md §2.1.
PYTH_HTTP_BASE_URL=https://hermes.pyth.network/api

# BellMarkets Anchor program ID — set once Aria's Sat 5/23 first deploy lands.
# Until then jobs log instead of submitting transactions.
PROGRAM_ID=

# Path to the operator keypair the service signs txs with. Devnet only —
# fund via `solana airdrop`. Never commit the keypair file itself.
# (The "operator" wallet has no special authority over settle_market per
# DR-002; it's a convenience caller like any user.)
ADMIN_KEYPAIR_PATH=./.keys/operator.json
