# BellMarkets automation service — env shape. NO REAL SECRETS in this file.
# Copy to .env (gitignored) and populate locally.
#
# Day-2 (2026-05-21): Aria's program is live on devnet — `BELL_MARKETS_PROGRAM_ID`
# below is the real deployed address. Wallet keypairs live under `keys/` at repo
# root (gitignored, w3swap pattern); reference by path, never inline.

# ── Trigger.dev ─────────────────────────────────────────────────────────────
# Project ref from app.trigger.dev. Falls back to "proj_bellmarkets_dev" if unset
# (see trigger.config.ts) so local `trigger dev` runs without a Trigger account.
TRIGGER_PROJECT_REF=

# ── Off-chain reads ─────────────────────────────────────────────────────────
# Solana devnet RPC. Helius free tier or vanilla devnet endpoint both work.
HELIUS_DEVNET_RPC_URL=https://api.devnet.solana.com

# Pyth Hermes HTTP — for the morning-job previous-close read. On-chain Pyth
# parsing happens in Aria's program; this is purely off-chain.
PYTH_HTTP_BASE_URL=https://hermes.pyth.network/api

# ── On-chain (Aria's deployed program) ──────────────────────────────────────
# Devnet program ID — Aria's Day-2 deploy. Real value, not a secret.
BELL_MARKETS_PROGRAM_ID=599h7VznYR4CxyrG5nQbhR13qtRuwPcbnNr5QqbkS7uV

# Path (relative to monorepo root or absolute) to the platform-admin keypair
# JSON. Used by morning-create-markets to sign create_strike_market — the
# program's `constraint = config.admin == admin.key()` requires this exact
# pubkey (7b17F2woUy9hgHcRjuLckBVAtNnKAJBRD769URvLprp5 on devnet).
#
# DR-002 reminder: this signer is required by the on-chain constraint, not by
# Bram-specific authority. Any wallet matching MarketConfig.admin can sign the
# same call — this service has no privilege the constraint doesn't grant.
PLATFORM_ADMIN_KEYPAIR_PATH=../../keys/devnet-platform-admin.json

# Devnet USDC mint. Must match MarketConfig.usdc_mint (set by initialize_config).
# Aria's deployment uses a synthetic devnet USDC; set this to whatever mint was
# passed to initialize_config on devnet.
USDC_DEVNET_MINT=

# Anchor IDL path (relative to services/automation/). Generated by
# `anchor build` and copied here. The committed file is `{}` until Aria
# replaces it post-build; the morning job fail-fasts with a clear message if
# the IDL is still the placeholder when it tries to construct the program.
BELL_MARKETS_IDL_PATH=src/idl/bell_markets.json

# ── Phoenix v1 FIFO market addresses (per ticker) ───────────────────────────
# Aria's create_strike_market handler verifies the 8-byte magic prefix on the
# phoenix_market account (programs/bell-markets/src/adapters/phoenix.rs). The
# call will reject anything that isn't a real Phoenix v1 FIFO market.
#
# Phoenix verification is Day-3 work (Aria handoff §"Risks" #1 — magic still
# plausible-but-unverified for real markets). Leave blank for now; the morning
# job skips any ticker whose PHOENIX_MARKET_<TICKER> is unset and logs a clear
# "skipped — no Phoenix market configured" line.
PHOENIX_MARKET_AAPL=
PHOENIX_MARKET_MSFT=
PHOENIX_MARKET_GOOGL=
PHOENIX_MARKET_AMZN=
PHOENIX_MARKET_NVDA=
PHOENIX_MARKET_META=
PHOENIX_MARKET_TSLA=

# ── Pyth on-chain price-account pubkeys (per ticker) ────────────────────────
# Bound to `StrikeMarket.underlying_pyth_feed` at create-strike-market time.
# Network-specific: devnet pubkeys differ from mainnet — look up from Pyth's
# published feed list (pyth.network/developers/price-feed-ids). Distinct from
# the Hermes 32-byte feed IDs used for the off-chain HTTP previous-close read
# (those are bundled in src/config.ts → PYTH_HERMES_FEED_IDS).
#
# Leave blank to skip a ticker until its devnet pubkey lands.
PYTH_PRICE_ACCOUNT_AAPL=
PYTH_PRICE_ACCOUNT_MSFT=
PYTH_PRICE_ACCOUNT_GOOGL=
PYTH_PRICE_ACCOUNT_AMZN=
PYTH_PRICE_ACCOUNT_NVDA=
PYTH_PRICE_ACCOUNT_META=
PYTH_PRICE_ACCOUNT_TSLA=
