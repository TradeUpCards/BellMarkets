{
  "name": "@bell-markets/automation",
  "version": "0.0.0",
  "private": true,
  "description": "BellMarkets automation service — morning create-markets (~8am ET) + settlement nudger (~4:05pm ET) via Trigger.dev. Permissionless convenience caller; not an authority (DR-002).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "trigger dev",
    "deploy": "trigger deploy",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "morning:once": "tsx --env-file=.env scripts/run-morning-once.ts",
    "settle:once": "tsx --env-file=.env scripts/run-settle-once.ts",
    "distribute:once": "tsx --env-file=.env scripts/run-distribute-once.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@coral-xyz/anchor": "0.30.1",
    "@neondatabase/serverless": "^0.10.4",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@trigger.dev/sdk": "^4.0.0",
    "arweave": "^1.15.5",
    "axios": "^1.7.7",
    "bs58": "^6.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.4.0",
    "next-auth": "^4.24.10",
    "tweetnacl": "^1.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@trigger.dev/build": "^4.0.0",
    "@types/node": "^20.14.10",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^7.4.2",
    "next": "14.2.18",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.5"
  },
  "peerDependencies": {
    "next": "^14.2.0"
  }
}
