# Public RPC endpoint for the Solana devnet cluster. Defaults to the public
# clusterApiUrl(devnet) when unset, which is rate-limited — set a Helius or
# QuickNode endpoint here before any meaningful testing or the demo.
NEXT_PUBLIC_SOLANA_RPC=

# Deployed BellMarkets Anchor program ID. Aria publishes this after her first
# successful `anchor deploy` on devnet — copy the printed Program ID here.
NEXT_PUBLIC_BELL_MARKETS_PROGRAM_ID=
