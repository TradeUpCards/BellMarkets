{
  "name": "@bell-markets/tests",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-cutting tests: devnet integration lifecycle, property/edge-case evals, compressed-time simulation. Owned by Drew. NOTE: `simulate` script points at ../scripts/simulate-trading-day.mjs which Drew hasn't authored yet (Day-1 scaffold) — it will fail until Drew lands the file.",
  "scripts": {
    "test": "ts-mocha -p tsconfig.json -t 1000000 'contracts/**/*_test.ts' 'contracts/**/test_*.ts' 'integration/**/*.test.ts' 'eval/**/*.test.ts'",
    "test:contracts": "ts-mocha -p tsconfig.json -t 1000000 'contracts/**/*_test.ts' 'contracts/**/test_*.ts'",
    "test:integration": "ts-mocha -p tsconfig.json 'integration/**/*.test.ts'",
    "test:eval": "ts-mocha -p tsconfig.json 'eval/**/*.test.ts'",
    "simulate": "node ../scripts/simulate-trading-day.mjs"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "^1.95.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "chai": "^4.5.0",
    "mocha": "^10.7.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.6.3"
  }
}
