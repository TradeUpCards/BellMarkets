// ============================================================
// BellMarkets — Architecture-as-Code (LikeC4)
//
// Single source of truth for "how the pieces talk to each other."
// Captures: 3 actors, 7 external systems, 4 internal containers,
// 10 program instructions, 4 on-chain data stores, ~40 components,
// ~50 relationships, 5 dynamic narratives, 1 deployment topology.
//
// Each element links back to its architectural commitment:
// Decision Records (DR-NNN), Spiky POVs (POV-N), Hard YESes (HY-N),
// or source code paths.
//
// Run:        npx likec4@1.30 start docs/architecture
// Validate:   npx likec4@1.30 build docs/architecture --output dist/arch
//
// Companion files in this directory:
//   - dynamics.c4     temporal narratives (daily lifecycle, etc.)
//   - deployment.c4   physical deployment topology
// ============================================================

specification {

  // ====== ELEMENT KINDS ======

  element actor {
    style {
      shape person
      color secondary
    }
  }

  element system {
    style {
      shape rectangle
    }
  }

  element container {
    style {
      shape rectangle
    }
  }

  element component {
    style {
      shape rectangle
    }
  }

  element store {
    style {
      shape storage
      color muted
    }
  }

  element instruction {
    style {
      shape rectangle
      color primary
    }
  }

  element cronjob {
    style {
      shape rectangle
      color amber
    }
  }

  element hook {
    style {
      shape rectangle
      color sky
    }
  }

  element builder {
    style {
      shape rectangle
      color sky
    }
  }

  // ====== TAGS: workstream ownership ======

  tag aria          // Onchain (Solana / Anchor)
  tag bram          // Automation Service (Node / TypeScript)
  tag cleo          // Frontend (Next.js / React)
  tag drew          // Quality + Integration

  // ====== TAGS: execution location ======

  tag onchain
  tag offchain
  tag external

  // ====== TAGS: authority model ======

  tag permissionless  // any signer; DR-002 commitment
  tag admin-only      // requires platform-admin keypair
  tag user-signed     // requires trader's wallet

  // ====== TAGS: lifecycle status ======

  tag shipped
  tag deferred
  tag planned

  // ====== TAGS: architectural commitments ======

  tag pov-1           // Phoenix CLOB > custom AMM
  tag pov-2           // Permissionless settle > admin gate
  tag pov-3           // Buy No / Sell No as first-class atomic ops

  tag hy-1            // $1 invariant enforced on-chain
  tag hy-5            // Cron-failure demo path
  tag hy-7            // Composite atomic tx
  tag hy-9            // Subscription-driven, never polling

  tag dr-002          // Permissionless settle
  tag dr-004          // Anchor CLI 0.31.1 + JS 0.30.1 mismatch

  // ====== STYLE: workstream colors ======

  style element.tag = aria {
    color indigo
  }
  style element.tag = bram {
    color amber
  }
  style element.tag = cleo {
    color sky
  }
  style element.tag = drew {
    color green
  }

  // ====== STYLE: authority + lifecycle ======

  style element.tag = permissionless {
    border solid
  }
  style element.tag = admin-only {
    border dashed
  }
  style element.tag = deferred {
    color muted
    border dotted
  }
  style element.tag = external {
    color muted
  }
}

// ============================================================
// MODEL — actors, external systems, BellMarkets
// ============================================================

model {

  // ============================================================
  // ACTORS
  // ============================================================

  trader = actor 'Trader' {
    description '
      Retail user. Connects a Solana wallet (Phantom, Solflare) to the dApp.
      Trades binary outcomes ("Will META close above $680 today?") for up
      to $1 USDC payout per contract. Non-custodial: their key never
      reaches our infrastructure — wallet adapter handles all signing.

      Typical session: connect → browse markets → mint pair → trade on
      Phoenix → settle resolves at 4 PM ET → redeem winners.
    '
    link https://github.com/anza-xyz/wallet-adapter
  }

  admin = actor 'Platform Admin' {
    description '
      Operator with the keypair 7b17F2woUy9hgHcRjuLckBVAtNnKAJBRD769URvLprp5.
      Signs:
        - initialize_config (one-time, already done 2026-05-22)
        - create_strike_market via Bram cron (morning 8 AM ET)
        - pause (manual circuit breaker)
        - admin_settle (manual override after expiry + 1 hour delay)

      Stewarded by Aria. Funded with 10 SOL on devnet. Mainnet would
      require Squads multisig or hardware wallet.
    '
  }

  cranker = actor 'Any wallet (cranker)' {
    description '
      DR-002 commitment: settle_market is permissionless. Any signer can
      crank settlement after expiry. Critical for the Hard YES #5
      cron-failure demo path — proves automation is convenience, not
      authority. The protocol works even if Trigger.dev disappears.
    '
  }

  // ============================================================
  // EXTERNAL SYSTEMS
  // ============================================================

  solana = system 'Solana Devnet' {
    description '
      L1 blockchain. Cluster: https://api.devnet.solana.com
      Slot at deploy: 312,847,193+
      Program deployed at: 599h7VznYR4CxyrG5nQbhR13qtRuwPcbnNr5QqbkS7uV
    '
    technology 'Solana 3.1.14'
    #external
  }

  pyth = system 'Pyth Network' {
    description '
      Pull-based oracle. Two surfaces we touch:
      (1) On-chain price accounts — read in settle_market via vendored
          30-line parser (Hard Rule §4.13 forbids pyth-sdk-solana).
      (2) Hermes HTTP API — used off-chain for spot display + staleness
          checks.

      Confidence policy in MarketConfig: 50 bps max confidence,
      300 sec max staleness. Settle abstains if either fails.
    '
    technology 'Pyth pull oracle'
    #external

    component pythPriceAccount 'On-chain price account' {
      description 'Per-feed PDA holding latest aggregate + confidence + slot.'
    }
    component pythHermesAPI 'Hermes HTTP API' {
      description 'Off-chain reads for strike calc + spot display.'
    }
  }

  phoenix = system 'Phoenix v1 CLOB' {
    description '
      On-chain limit-order book program by Ellipsis Labs.
      Each StrikeMarket binds to one FIFOMarket account. The
      MarketHeader discriminant (8167313896524341111 = bytes
      [0x77, 0xDF, 0x71, 0x73, 0xB7, 0x20, 0x58, 0x71]) is verified
      via tripwire unit test in adapters/phoenix.rs.

      Devnet markets enumerated in
      .project/bell-markets/coordination/devnet-pubkeys.md.
    '
    technology 'Phoenix v1 (Ellipsis Labs)'
    #external
    link https://github.com/Ellipsis-Labs/phoenix-v1
  }

  circle = system 'Circle (USDC issuer)' {
    description '
      Devnet USDC mint: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
      Pinned in MarketConfig.usdc_mint. Test USDC from faucet.circle.com.
      Mainnet would use the canonical USDC mint EPjFWdd...
    '
    technology 'SPL Token (USDC)'
    #external
  }

  triggerDev = system 'Trigger.dev v4' {
    description '
      Hosted cron platform. Free tier sufficient for MVP (1k tasks/month,
      30-second timeout). Two scheduled jobs:
        - Morning create-markets: cron "0 13 * * 1-5" (8 AM ET EDT)
        - Settlement nudger: cron "5 21 * * 1-5" (4:05 PM ET EDT)

      DR-002 means cron is convenience, not authority — protocol
      degrades gracefully if Trigger.dev fails.
    '
    technology 'Trigger.dev v4 (cron)'
    #external
  }

  helius = system 'Helius RPC' {
    description '
      Solana RPC + WebSocket provider. Subscription-driven account
      updates feed Cleo s TanStack Query hooks (HY-9: never polling).
      Auth via HELIUS_API_KEY env var; rate limits are healthy for
      MVP traffic.
    '
    technology 'Helius RPC + WebSocket'
    #external
  }

  walletAdapter = system 'Solana Wallet Adapter' {
    description '
      @solana/wallet-adapter-react. Frontend never sees the trader s
      private key — Phantom / Solflare handle all signing in-extension.
      Non-custodial enforcement starts here.
    '
    technology '@solana/wallet-adapter-react'
    #external
  }

  // ============================================================
  // BELLMARKETS — the system we built
  // ============================================================

  bellMarkets = system 'BellMarkets' {
    description '
      Non-custodial Solana dApp for trading binary outcome contracts on
      daily MAG7 stock closes. $1 USDC max payout per contract. Same-day
      expiry (4 PM ET). Permissionless settlement. 7 stocks × ~5 strikes
      = ~35 markets/day.

      Built across 4 workstreams in parallel via Mode 2 worktrees.
      Day-0 deploy: 2026-05-21. Day-3+ state: program live on devnet,
      MarketConfig initialized, all 4 workstreams shipped.
    '

    // ========================================================
    // ARIA — Anchor program (onchain)
    // ========================================================

    program = container 'Anchor Program' {
      description '
        Deployed at 599h7VznYR4CxyrG5nQbhR13qtRuwPcbnNr5QqbkS7uV.
        Anchor 0.31.1 / Rust 1.95. 9 instructions shipped, 1 planned.
        .so size 424 KB. ProgramData rent 2.95 SOL. Upgrade authority
        9snc1xMYHPQbJuaybP98z6YS6xBbzhDTnXiNoKRawanZ.

        Owned by Aria. File ownership: programs/**, tests/contracts/**,
        Anchor.toml, Cargo.toml.
      '
      technology 'Rust 1.95 + Anchor 0.31.1'
      #aria #onchain
      link https://explorer.solana.com/address/599h7VznYR4CxyrG5nQbhR13qtRuwPcbnNr5QqbkS7uV?cluster=devnet

      // ---------- The 10 instructions ----------

      initConfig = instruction 'initialize_config' {
        description '
          One-time bootstrap. Creates MarketConfig PDA. Uses Anchor s
          #[account(init)] constraint — ONE-WAY DOOR (no recovery if
          wrong admin set). Called from migrations/bootstrap-config
          Rust binary on 2026-05-22 (tx 3qJbdLe55GG...).

          Args: price_staleness_secs, price_confidence_bps,
                admin_override_delay_secs.
        '
        #aria #admin-only #shipped
      }

      createMarket = instruction 'create_strike_market' {
        description '
          Per-strike market creation. Validates Phoenix magic prefix on
          the phoenix_market account. Allocates StrikeMarket PDA +
          YES + NO mints + USDC vault. Hard Rule §4.12 enforced.

          Args: strike_price, expiry_unix.
        '
        #aria #admin-only #shipped
      }

      addStrike = instruction 'add_strike' {
        description 'No-op surface; reserved for future batch creator.'
        #aria #admin-only #shipped
      }

      mintPair = instruction 'mint_pair' {
        description '
          THE $1 INVARIANT PRIMITIVE (HY-1). Transfer N USDC → mint N YES
          + N NO to caller. Any user, any time before settle. Reverse of
          redeem_pair (deferred).

          Args: amount: u64
        '
        #aria #permissionless #shipped #hy-1
      }

      settleMarket = instruction 'settle_market' {
        description '
          DR-002 PERMISSIONLESS SETTLE. Reads Pyth price account, applies
          confidence + staleness check, writes settle_price + outcome
          enum. settle_price != 0 is the discriminator vs admin path.

          Anyone can crank. Even if Bram s automation dies, the cranker
          actor can call this from a random wallet. HY-5 demo path.

          Args: none
        '
        #aria #permissionless #shipped #pov-2 #dr-002 #hy-5
      }

      adminSettle = instruction 'admin_settle' {
        description '
          Manual outcome override. Eligible only after expiry +
          admin_override_delay_secs (1 hour default). Leaves
          settle_price = 0 as discriminator vs oracle path.

          Args: forced_outcome: Outcome (Yes | No | Invalid)
        '
        #aria #admin-only #shipped
      }

      redeem = instruction 'redeem' {
        description '
          Burn winning token → $1 USDC. Post-settle, winning side only.
          Reverts if user holds the losing token.

          Args: amount: u64
        '
        #aria #permissionless #shipped
      }

      redeemInvalid = instruction 'redeem_invalid' {
        description '
          Day-3 addition. Burn equal YES + NO for $1 USDC refund.
          Triggers only when settle_market routed to Outcome::Invalid
          (oracle staleness during settle window).

          Args: amount: u64
        '
        #aria #permissionless #shipped
      }

      pauseIx = instruction 'pause' {
        description '
          Global circuit breaker. Sets MarketConfig.paused = true,
          halts mint_pair + trade paths. Redeems still work (users can
          always exit). Designed for "found a bug" emergencies.

          Args: paused: bool
        '
        #aria #admin-only #shipped
      }

      redeemPair = instruction 'redeem_pair' {
        description '
          NEXT-SESSION WORK (Cleo s ask). Pre-settlement inverse of
          mint_pair: burn 1 YES + 1 NO → receive 1 USDC. Required for
          POV-3 atomic Sell No flow (buy YES from order book + burn
          pair → walk away with USDC).

          Args: amount: u64
        '
        #aria #permissionless #deferred #pov-3
      }

      // ---------- Adapters ----------

      pythAdapter = component 'Pyth adapter' {
        description '
          30-line vendored price-account parser. We refuse to import
          pyth-sdk-solana (Hard Rule §4.13) because its Borsh-cascade
          would explode our .so size. Tripwire test verifies our
          parser against canonical Pyth fixtures.
        '
        #aria
      }

      phoenixAdapter = component 'Phoenix adapter' {
        description '
          UncheckedAccount + manual byte-layout read (Hard Rule §4.12).
          Validates the 8-byte MarketHeader discriminant on every
          binding call.
        '
        #aria
      }

      stateModule = component 'state.rs' {
        description '
          MarketConfig, StrikeMarket, Outcome enum. Box<Account<T>> on
          every heavy account (Hard Rule §4.10) — BPF s 4KB stack
          can t hold StrikeMarket inline.
        '
        #aria
      }

      errorModule = component 'errors.rs' {
        description 'Custom Anchor error codes: PythConfidenceTooWide, PythStale, ConfigMismatch, ...'
        #aria
      }
    }

    // ========================================================
    // ARIA — On-chain data stores
    // ========================================================

    marketConfig = store 'MarketConfig PDA' {
      description '
        Singleton at 6CYzWhTMzsndRrnRcHgWCUfVDvrRh3Cfoze6GSVev9gQ.
        Initialized 2026-05-22 (tx 3qJbdLe55GG...).
        Holds: admin pubkey, usdc_mint, treasury, staleness=300s,
        confidence=50bps, override_delay=3600s, paused=false.
      '
      #aria #onchain
    }

    strikeMarkets = store 'StrikeMarket PDAs' {
      description '
        One per (ticker, strike, expiry). Holds outcome enum (None until
        settle), settle_price (0 = admin path discriminator),
        pairs_outstanding (invariant: vault USDC == pairs × $1),
        Phoenix market binding.

        Created daily by Bram s morning cron. ~35 per trading day.
      '
      #aria #onchain
    }

    yesNoMints = store 'YES / NO token mints' {
      description '
        SPL token mints, one pair per StrikeMarket. Authority = program
        PDA. Decimals = 6 (USDC parity). Created in create_strike_market.
      '
      #aria #onchain
    }

    usdcVault = store 'USDC vault (per market)' {
      description '
        PDA-owned token account. Holds 1 USDC per outstanding pair.
        Drains exactly when pairs_outstanding × $1 are redeemed.
        $1 INVARIANT enforcement happens here (HY-1).
      '
      #aria #onchain #hy-1
    }

    // ========================================================
    // BRAM — Automation Service (offchain cron)
    // ========================================================

    automation = container 'Automation Service' {
      description '
        Trigger.dev v4 cron jobs. Owned by Bram. File ownership:
        services/automation/**, services/oracle-adapter/**,
        tests/automation/**.

        76/76 vitest passing, `tsc --noEmit` clean. Pure-function
        extraction means tests run in ~20ms without web3.js or
        Trigger.dev runtime loaded.

        Deferred-import pattern (clients/anchor.ts, clients/helius.ts)
        dodges the DR-004 rpc-websockets/uuid CJS-ESM cascade.
      '
      technology 'Node 22 + TypeScript strict + Trigger.dev v4'
      #bram #offchain

      morningJob = cronjob 'Morning create-markets' {
        description '
          Cron expression: 0 13 * * 1-5 (8 AM ET EDT; DST flip not yet
          handled — non-blocker for MVP).

          Flow: read PYTH_HERMES_FEED_IDS → fetch spot via Hermes →
          compute ATM ± 3/6/9% strikes (strike-calc) → for each MAG7
          ticker, sign create_strike_market with platform admin keypair.

          Idempotent: re-running on the same day no-ops (market PDAs
          already exist).
        '
        #bram
      }

      settlementJob = cronjob 'Settlement nudger' {
        description '
          Cron expression: 5 21 * * 1-5 (4:05 PM ET EDT, 5 min after
          market close to let Pyth update).

          Flow: program.account.strikeMarket.all() → filter outcome.is_none
          AND expiry_unix < now → for each, call settle_market with
          retry harness on PythConfidenceTooWide / PythStale / RPC blips
          (PRD 30s × 15min). Non-retriable errors abort immediately;
          retriable errors continue per-market in parallel.
        '
        #bram
      }

      retryHelper = component 'retryUntilDeadline' {
        description '
          Pure deadline-bounded retry helper. Signature:
            retryUntilDeadline(fn, { intervalMs, deadlineMs, shouldRetry, now?, sleep? })
          Three terminal states: success, non-retriable abort, deadline
          exhausted. Injectable clock + sleep makes 7 unit tests run in
          microseconds. Reusable across morning job (future) + settlement.
        '
        #bram
      }

      heliusClient = component 'Helius RPC client' {
        description '
          Anchor program loader + subscription wrappers. web3.js
          deferred-imported inside function bodies so vitest never
          touches the rpc-websockets/uuid cascade.
        '
        #bram
      }

      hermesClient = component 'Pyth Hermes client' {
        description 'HTTP fetch for off-chain price reads. Injectable fetchImpl for testing.'
        #bram
      }

      strikeCalc = component 'strike-calc.ts' {
        description '
          Pure math: ATM ± 3/6/9% rounded to ticker-specific cents.
          PRD-verified against META + AAPL example test vectors.
          Zero side-effects; trivially testable.
        '
        #bram
      }

      anchorClient = component 'anchor.ts' {
        description '
          Anchor client wrapper. Loads the IDL at services/automation/
          src/idl/bell_markets.json. Defers web3.js import.
          Throws AnchorClientError on the {} placeholder until IDL
          actually lands.
        '
        #bram
      }
    }

    // ========================================================
    // CLEO — Frontend (offchain browser)
    // ========================================================

    frontend = container 'Web App' {
      description '
        Next.js 14.2.18 / React 18 / TypeScript strict. Owned by Cleo.
        File ownership: apps/web/**, packages/ui/**, tests/frontend/**.

        Day-3 state: backend integration layer complete (6 hooks + 7 tx
        builders). Visual layer paused pending mockup decision. Dev
        server boots clean; production build hangs at Next.js banner
        (deferred — transpilePackages likely fix).
      '
      technology 'Next.js 14 + React 18 + TypeScript + Tailwind'
      #cleo #offchain

      // ---------- Routes ----------

      pages = component 'Routes' {
        description '
          5 page shells:
          - /                            landing (markets grid)
          - /markets                     full market list
          - /trade/[ticker]/[strike]     trading terminal (load-bearing UX)
          - /portfolio                   user positions across all markets
          - /history                     settled-markets archive
        '
        #cleo
      }

      // ---------- Wallet integration ----------

      walletConnect = component 'Wallet integration' {
        description '
          @solana/wallet-adapter-react + Phantom + Solflare individual
          packages. Wallet provider wraps the entire app at the root
          layout. Connection state propagates via React context.
          Frontend NEVER sees the trader s private key.
        '
        #cleo
      }

      // ---------- Subscription-driven hooks (HY-9) ----------

      useAccountSubscription = hook 'useAccountSubscription' {
        description '
          Generic subscription hook. Bridges Helius onAccountChange →
          TanStack Query setQueryData. NO POLLING (HY-9). Used by all
          downstream hooks.
        '
        #cleo #hy-9
      }

      useAllMarkets = hook 'useAllMarkets' {
        description 'Paginates program.account.strikeMarket.all(); subscription on each PDA.'
        #cleo #hy-9
      }

      useMarketAccount = hook 'useMarketAccount' {
        description 'Single StrikeMarket fetch + subscription. Returns deserialized struct.'
        #cleo #hy-9
      }

      useTokenBalance = hook 'useTokenBalance' {
        description 'Per-mint user balance via getParsedTokenAccountsByOwner + subscription.'
        #cleo #hy-9
      }

      usePosition = hook 'usePosition' {
        description 'Composite: YES + NO balances for a given market PDA.'
        #cleo
      }

      useOrderBook = hook 'useOrderBook' {
        description '
          Phoenix order book reader. Bridges PhoenixSDK reads through
          subscription to FIFOMarket account. Snapshots emit on every
          fill/cancel.
        '
        #cleo #hy-9
      }

      idlClient = component 'useBellMarketsProgram' {
        description '
          Returns a real Program<Idl> from committed IDL at
          programs/bell-markets/idl/bell_markets.json. Connection +
          wallet provider injected via context.
        '
        #cleo
      }

      // ---------- Atomic tx builders (POV-3, HY-7) ----------

      buildMintPair = builder 'mintPair tx' {
        description 'Single instruction: program.methods.mintPair(amount).rpc()'
        #cleo
      }

      buildBuyYes = builder 'buyYes tx (atomic)' {
        description '
          Single Phoenix place_order ix. User buys YES from CLOB asks.
          One signature.
        '
        #cleo #hy-7
      }

      buildBuyNo = builder 'buyNo tx (atomic)' {
        description '
          THE POV-3 SIGNATURE TX. Composite atomic:
            ix0: mint_pair(amount)        // get 1 YES + 1 NO
            ix1: phoenix sell_yes(amount) // sell the YES on CLOB
          Net: user paid (1 - YES_price) × amount, holds amount NO.
          One signature. If either ix fails, both revert (atomicity).
        '
        #cleo #pov-3 #hy-7
      }

      buildSellYes = builder 'sellYes tx (atomic)' {
        description 'Single Phoenix place_order on bids. One signature.'
        #cleo
      }

      buildSellNo = builder 'sellNo tx (atomic, BLOCKED)' {
        description '
          POV-3 INVERSE. Composite atomic:
            ix0: phoenix buy_yes(amount)  // get 1 YES from CLOB
            ix1: redeem_pair(amount)      // burn pair → 1 USDC
          BLOCKED on Aria s next session shipping redeem_pair.
          Currently stubbed.
        '
        #cleo #pov-3 #deferred
      }

      buildRedeem = builder 'redeem tx' {
        description 'Post-settle: burn winning token → 1 USDC.'
        #cleo
      }

      // ---------- Order book reader ----------

      phoenixReader = component 'Phoenix SDK reader' {
        description '@ellipsis-labs/phoenix-sdk. Reads + decodes FIFOMarket state for UI rendering.'
        #cleo
      }
    }

    // ========================================================
    // DREW — Quality + Integration + Demo
    // ========================================================

    quality = container 'Quality + Integration' {
      description '
        Cross-workstream verification layer. Owned by Drew.
        File ownership: tests/integration/**, tests/eval/**,
        docs/demo/**, scripts/one-command-demo.sh.

        Test runners: mocha + chai + ts-mocha for Anchor/integration/
        eval. Vitest for automation. Jest for frontend. Per DR-spec.

        Replaces traditional fast-check/proptest with compressed-time
        simulation: 60 seconds = 1 trading day, 3 wallets exercise full
        lifecycle. Higher-signal-per-line than property tests for our
        domain.
      '
      technology 'mocha + chai + ts-mocha'
      #drew #offchain

      simulation = component 'simulate-trading-day.mjs' {
        description '
          Compressed-time lifecycle simulation. Phases:
            Phase 1: morning create
            Phase 2: trader 1 mints + buys YES
            Phase 3: trader 2 mints + buys NO (atomic via Cleo s builder)
            Phase 4: Bram s cron settles (or Carol cranks if cron mocked dead)
            Phase 5: traders 1 & 2 redeem outcomes
            Phase 6: invariants verified

          5 invariants checked: $1 USDC matches outstanding pairs, settle
          immutability, redeem mass balance, permissionless settle proof,
          phoenix order book residuals = 0.

          Runs in 11ms against the mocked aria-interface. ~30 sec against
          live program.
        '
        #drew
      }

      edgeCases = component 'mocha edge cases' {
        description '
          I3: settle_market twice → second call MUST fail (immutability).
          DR-002 proof: unfunded random wallet calls settle_market → MUST
          succeed (permissionless).
          I4: invalid outcome → redeem_invalid burns equal pair → exact
          $1 returned.
        '
        #drew
      }

      ariaMock = component 'aria-interface mock' {
        description '
          TypeScript mirror of Aria s IDL. Drew built this before Aria
          shipped to unblock parallel work. After Aria s IDL committed
          2026-05-22, Drew reconciles drift.
        '
        #drew
      }

      cronFailureDemo = component 'Cron-failure demo (HY-5)' {
        description '
          PLANNED Day-3 work. docs/demo/cron-failure-path.md + a
          --kill-cron-at=phase3 flag in the simulation. Proves the
          DR-002 commitment: when Bram s automation is killed mid-flight,
          a random user (cranker actor) successfully calls settle from
          their own keypair. Highest-value demo artifact for interview.
        '
        #drew #hy-5 #planned
      }

      oneCommandDemo = component 'scripts/one-command-demo.sh' {
        description '
          PRD-required reproducible lifecycle path. Single shell command
          spins up a wallet, mints, trades, settles, and redeems. For
          interview defense: "I can show you the full lifecycle in 30s."
        '
        #drew
      }
    }
  }

  // ============================================================
  // RELATIONSHIPS — who talks to whom
  // ============================================================

  // ---------- User-facing flows ----------

  trader -> walletAdapter 'Approves tx in extension'
  trader -> bellMarkets.frontend 'Trades in browser'
  walletAdapter -> trader 'Signs tx; private key stays in wallet'

  // ---------- Admin operates automation + program ----------

  admin -> bellMarkets.automation 'Operates cron via Trigger.dev dashboard (or locally with keypair)'
  admin -> bellMarkets.program.initConfig 'Signs initialize_config (done 2026-05-22)'
  admin -> bellMarkets.program.pauseIx 'Signs pause / unpause (circuit breaker)'
  admin -> bellMarkets.program.adminSettle 'Signs manual override (after delay)'

  // ---------- Anyone can crank (POV-2 / DR-002 / HY-5) ----------

  cranker -> bellMarkets.program.settleMarket 'Permissionless crank if Bram cron fails'
  cranker -> bellMarkets.program.mintPair 'Open positions any time pre-settle'
  cranker -> bellMarkets.program.redeem 'Claim winners post-settle'
  cranker -> bellMarkets.program.redeemInvalid 'Refund on Invalid outcome'

  // ---------- Frontend → external + program ----------

  bellMarkets.frontend -> walletAdapter 'Uses for signing'
  bellMarkets.frontend.idlClient -> bellMarkets.program 'Loads IDL + builds Program<Idl>'
  bellMarkets.frontend.buildMintPair -> bellMarkets.program.mintPair 'Submits user-signed tx'
  bellMarkets.frontend.buildBuyYes -> phoenix 'Phoenix place_order on asks'
  bellMarkets.frontend.buildBuyNo -> bellMarkets.program.mintPair 'Step 1 of atomic Buy No'
  bellMarkets.frontend.buildBuyNo -> phoenix 'Step 2 of atomic Buy No: sell YES'
  bellMarkets.frontend.buildSellYes -> phoenix 'Phoenix place_order on bids'
  bellMarkets.frontend.buildSellNo -> phoenix 'BLOCKED: needs redeem_pair'
  bellMarkets.frontend.buildSellNo -> bellMarkets.program.redeemPair 'BLOCKED: deferred ix'
  bellMarkets.frontend.buildRedeem -> bellMarkets.program.redeem 'Post-settle claim'

  bellMarkets.frontend.useAccountSubscription -> helius 'WebSocket onAccountChange'
  bellMarkets.frontend.useAllMarkets -> bellMarkets.strikeMarkets 'Subscribes to all PDAs'
  bellMarkets.frontend.useMarketAccount -> bellMarkets.strikeMarkets 'Subscribes to one PDA'
  bellMarkets.frontend.useTokenBalance -> bellMarkets.yesNoMints 'Subscribes to user ATA'
  bellMarkets.frontend.useOrderBook -> phoenix 'Subscribes to FIFOMarket'
  bellMarkets.frontend.phoenixReader -> phoenix 'Decodes order book state'

  bellMarkets.frontend -> pyth.pythHermesAPI 'Spot price display'

  // ---------- Automation → program + external ----------

  bellMarkets.automation -> triggerDev 'Scheduled via free-tier cron'
  bellMarkets.automation.morningJob -> bellMarkets.automation.strikeCalc 'Computes strikes'
  bellMarkets.automation.morningJob -> bellMarkets.automation.hermesClient 'Spot from Hermes'
  bellMarkets.automation.morningJob -> bellMarkets.automation.anchorClient 'Builds + signs tx'
  bellMarkets.automation.morningJob -> bellMarkets.program.createMarket 'Signs with platform admin × 35'
  bellMarkets.automation.settlementJob -> bellMarkets.automation.anchorClient 'Loads program + lists markets'
  bellMarkets.automation.settlementJob -> bellMarkets.automation.retryHelper 'PRD 30s × 15min bounded retry'
  bellMarkets.automation.settlementJob -> bellMarkets.program.settleMarket 'Cranks each unsettled × 35'
  bellMarkets.automation.anchorClient -> bellMarkets.automation.heliusClient 'RPC connection'
  bellMarkets.automation.heliusClient -> helius 'RPC + WebSocket'
  bellMarkets.automation.hermesClient -> pyth.pythHermesAPI 'HTTP price fetch'

  // ---------- Program → external + own data ----------

  bellMarkets.program -> solana 'Deployed at 599h7V...kS7uV'
  bellMarkets.program.pythAdapter -> pyth.pythPriceAccount 'Reads on-chain price in settle_market'
  bellMarkets.program.phoenixAdapter -> phoenix 'Magic-prefix verify on create_strike_market'
  bellMarkets.program -> circle 'Vault holds USDC; mint pinned in MarketConfig'

  bellMarkets.program.initConfig -> bellMarkets.marketConfig 'Creates singleton (one-way door)'
  bellMarkets.program.createMarket -> bellMarkets.strikeMarkets 'Allocates per-strike PDA'
  bellMarkets.program.createMarket -> bellMarkets.yesNoMints 'Mints YES + NO authority = program PDA'
  bellMarkets.program.createMarket -> bellMarkets.usdcVault 'Allocates per-market vault'
  bellMarkets.program.mintPair -> bellMarkets.yesNoMints 'mint_to(YES) + mint_to(NO)'
  bellMarkets.program.mintPair -> bellMarkets.usdcVault 'transfer USDC in'
  bellMarkets.program.settleMarket -> bellMarkets.strikeMarkets 'writes outcome + settle_price'
  bellMarkets.program.settleMarket -> bellMarkets.program.pythAdapter 'reads price'
  bellMarkets.program.adminSettle -> bellMarkets.strikeMarkets 'writes outcome, settle_price stays 0'
  bellMarkets.program.redeem -> bellMarkets.yesNoMints 'burn winning token'
  bellMarkets.program.redeem -> bellMarkets.usdcVault 'transfer USDC out'
  bellMarkets.program.redeemInvalid -> bellMarkets.yesNoMints 'burn equal YES + NO'
  bellMarkets.program.redeemInvalid -> bellMarkets.usdcVault 'transfer pair USDC out'
  bellMarkets.program.redeemPair -> bellMarkets.yesNoMints 'burn pair (pre-settle)'
  bellMarkets.program.redeemPair -> bellMarkets.usdcVault 'transfer USDC out (pre-settle)'
  bellMarkets.program.pauseIx -> bellMarkets.marketConfig 'sets paused = true'

  // ---------- Quality observes everything ----------

  bellMarkets.quality.simulation -> bellMarkets.program 'End-to-end live program calls'
  bellMarkets.quality.simulation -> bellMarkets.automation 'Optionally exercises cron'
  bellMarkets.quality.simulation -> bellMarkets.frontend.buildBuyNo 'Tests POV-3 atomic flow'
  bellMarkets.quality.edgeCases -> bellMarkets.program.settleMarket 'I3 + DR-002 invariants'
  bellMarkets.quality.cronFailureDemo -> cranker 'Demonstrates permissionless settle'
  bellMarkets.quality.cronFailureDemo -> bellMarkets.automation.settlementJob 'Simulates death'
}

// ============================================================
// STRUCTURAL VIEWS
// (dynamic views in dynamics.c4, deployment in deployment.c4)
// ============================================================

views {

  // -------- 1. SYSTEM CONTEXT (the 10,000ft view) --------

  view index {
    title 'BellMarkets — System Context'
    description '
      The whole picture: BellMarkets sits between traders, an admin
      operator, anyone-with-a-keypair (DR-002 cranker), and 7 external
      systems on the Solana ecosystem. Open this first.
    '

    include *

    style * {
      opacity 90%
    }
  }

  // -------- 2. INTERNAL CONTAINERS --------

  view containers of bellMarkets {
    title 'BellMarkets — Internal Containers'
    description '
      Zoom into BellMarkets: 4 workstream containers (program, automation,
      frontend, quality) + 4 on-chain data stores. Color-coded by lead.
    '

    include
      bellMarkets,
      bellMarkets.*,
      trader,
      admin,
      cranker,
      solana,
      pyth,
      phoenix,
      circle,
      triggerDev,
      helius,
      walletAdapter
  }

  // -------- 3. PROGRAM DETAIL (Aria's domain) --------

  view program of bellMarkets.program {
    title 'Anchor Program — All Instructions'
    description '
      All 10 instructions. Solid borders = permissionless (DR-002),
      dashed borders = admin-only, dotted = deferred (redeem_pair).
      Includes the 4 on-chain data stores and 3 external systems
      the program touches.
    '

    include
      bellMarkets.program,
      bellMarkets.program.*,
      bellMarkets.marketConfig,
      bellMarkets.strikeMarkets,
      bellMarkets.yesNoMints,
      bellMarkets.usdcVault,
      pyth,
      phoenix,
      circle,
      admin,
      cranker
  }

  // -------- 4. AUTOMATION DETAIL (Bram's domain) --------

  view automation of bellMarkets.automation {
    title 'Automation Service — Cron + Retry Harness'
    description '
      Two cron jobs + 5 supporting components. The retry harness is
      reusable; both jobs use the same Anchor client wrapper with
      deferred web3.js import (DR-004 cascade mitigation).
    '

    include
      bellMarkets.automation,
      bellMarkets.automation.*,
      bellMarkets.program.createMarket,
      bellMarkets.program.settleMarket,
      triggerDev,
      helius,
      pyth,
      admin
  }

  // -------- 5. FRONTEND DETAIL (Cleo's domain) --------

  view frontend of bellMarkets.frontend {
    title 'Frontend — Hooks + Atomic Tx Builders'
    description '
      6 subscription-driven hooks (HY-9: never polling). 7 atomic tx
      builders, including the POV-3 signature: buildBuyNo and buildSellNo.
      Wallet adapter is the trust boundary — frontend never sees the
      private key.
    '

    include
      bellMarkets.frontend,
      bellMarkets.frontend.*,
      bellMarkets.program,
      trader,
      walletAdapter,
      helius,
      phoenix,
      pyth
  }

  // -------- 6. QUALITY DETAIL (Drew's domain) --------

  view quality of bellMarkets.quality {
    title 'Quality + Integration + Demo'
    description '
      Drew s cross-workstream verification. Compressed-time simulation
      replaces traditional property testing for this domain. The cron-
      failure demo (HY-5) is the highest-value interview artifact —
      shows the protocol survives automation death.
    '

    include
      bellMarkets.quality,
      bellMarkets.quality.*,
      bellMarkets.program,
      bellMarkets.automation,
      bellMarkets.frontend.buildBuyNo,
      cranker
  }

  // -------- 7. POV-3 atomic Buy No / Sell No --------

  view pov3 {
    title 'POV-3 — Buy No / Sell No as Atomic First-Class Ops'
    description '
      The signature UX commitment. Most binary-options dApps make Sell
      a multi-step user journey: mint pair, then sell one side
      separately. We refused that. buildBuyNo bundles mint + sell into
      one signature; buildSellNo will do the inverse once redeem_pair
      ships. If either inner ix fails, both revert (atomicity).
    '

    include
      bellMarkets.frontend.buildBuyNo,
      bellMarkets.frontend.buildSellNo,
      bellMarkets.program.mintPair,
      bellMarkets.program.redeemPair,
      bellMarkets.yesNoMints,
      bellMarkets.usdcVault,
      phoenix,
      trader,
      walletAdapter
  }

  // -------- 8. PERMISSIONLESS PATHS (DR-002 / POV-2 / HY-5) --------

  view permissionless {
    title 'Permissionless Paths — DR-002 in One View'
    description '
      Every instruction with the permissionless tag. Highlights what
      ANY signer (cranker actor) can call: settle_market, mint_pair,
      redeem, redeem_invalid, plus the planned redeem_pair. The protocol
      degrades gracefully when Bram s cron dies — that s the HY-5 demo.
    '

    include
      cranker,
      bellMarkets.program.settleMarket,
      bellMarkets.program.mintPair,
      bellMarkets.program.redeem,
      bellMarkets.program.redeemInvalid,
      bellMarkets.program.redeemPair,
      bellMarkets.program,
      bellMarkets.strikeMarkets,
      bellMarkets.usdcVault,
      bellMarkets.yesNoMints,
      pyth
  }

  // -------- 9. ADMIN-ONLY SURFACE --------

  view adminOnly {
    title 'Admin-Only Surface — The 4 Authority Boundaries'
    description '
      Everything the platform admin keypair gates. Designed deliberately
      tiny: initialize (one-time), create_strike_market (daily cron),
      pause (emergency), admin_settle (manual override after delay).
      Smaller admin footprint = lower honeypot value for keypair leaks.
    '

    include
      admin,
      bellMarkets.program.initConfig,
      bellMarkets.program.createMarket,
      bellMarkets.program.adminSettle,
      bellMarkets.program.pauseIx,
      bellMarkets.program,
      bellMarkets.marketConfig
  }

  // -------- 10. PER-LEAD: Aria's surface --------

  view aria {
    title 'Aria — Onchain Workstream'
    description '
      Everything Aria owns: the program, its 10 instructions, its
      adapters, the 4 on-chain data stores. File ownership:
      programs/**, tests/contracts/**, Anchor.toml, Cargo.toml.
    '

    include
      bellMarkets.program,
      bellMarkets.program.*,
      bellMarkets.marketConfig,
      bellMarkets.strikeMarkets,
      bellMarkets.yesNoMints,
      bellMarkets.usdcVault,
      solana,
      pyth,
      phoenix,
      circle
  }

  // -------- 11. PER-LEAD: Bram's surface --------

  view bram {
    title 'Bram — Automation Workstream'
    description '
      Bram s service + its dependencies. File ownership:
      services/automation/**, services/oracle-adapter/**,
      tests/automation/**.
    '

    include
      bellMarkets.automation,
      bellMarkets.automation.*,
      bellMarkets.program,
      triggerDev,
      helius,
      pyth,
      admin
  }

  // -------- 12. PER-LEAD: Cleo's surface --------

  view cleo {
    title 'Cleo — Frontend Workstream'
    description '
      Cleo s app + every hook + every tx builder. File ownership:
      apps/web/**, packages/ui/**, tests/frontend/**.
    '

    include
      bellMarkets.frontend,
      bellMarkets.frontend.*,
      bellMarkets.program,
      trader,
      walletAdapter,
      helius,
      phoenix
  }

  // -------- 13. PER-LEAD: Drew's surface --------

  view drew {
    title 'Drew — Quality + Demo Workstream'
    description '
      Drew s cross-cutting layer. File ownership:
      tests/integration/**, tests/eval/**, docs/demo/**,
      scripts/one-command-demo.sh.
    '

    include
      bellMarkets.quality,
      bellMarkets.quality.*,
      bellMarkets.program,
      bellMarkets.automation,
      bellMarkets.frontend.buildBuyNo,
      cranker
  }
}
